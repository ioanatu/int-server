# Port the HTTP server binds to (Heroku injects this automatically).
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# Shared secret expected in the `X-SESSION` header of every /api/** request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN=local-dev-session-token

# Enable/disable the Swagger UI at /api-docs (set to false to hide it in production).
SWAGGER_ENABLED=true

# Comma-separated list of allowed CORS origins, or * for any origin.
CORS_ORIGINS=*
